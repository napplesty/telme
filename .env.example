# Telme Server Configuration
# All variables use the TELME_SERVER_ prefix.
# Copy this file to .env and adjust values as needed.

# Application info
TELME_SERVER_APP_NAME=Telme Server
TELME_SERVER_VERSION=0.1.0

# Server
TELME_SERVER_HOST=0.0.0.0
TELME_SERVER_PORT=8000
TELME_SERVER_DEBUG=false

# Security
TELME_SERVER_MAX_MESSAGE_SIZE=1048576    # 1MB in bytes
TELME_SERVER_MESSAGE_TTL=300             # seconds before messages expire
TELME_SERVER_TIMESTAMP_TOLERANCE=300     # seconds of clock skew allowed
TELME_SERVER_CLEANUP_INTERVAL=30         # seconds between cleanup runs

# Rate limiting
TELME_SERVER_RATE_LIMIT_ENABLED=true
TELME_SERVER_RATE_LIMIT_REQUESTS=100     # max requests per period
TELME_SERVER_RATE_LIMIT_PERIOD=60        # period in seconds

# API
TELME_SERVER_API_VERSION=v1
TELME_SERVER_API_PREFIX=/api/v1
